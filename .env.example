# Required: Anthropic API key for the translation + ASR-repair stage.
# Alternatively run `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=

# Optional overrides
TWI_MODEL=claude-opus-5
TWI_EFFORT=low           # low | medium | high
TWI_GRIOT_DIR=models/griot-edge
TWI_PIPER_VOICE=models/kasanoma-twi/kasanoma-twi-medium.onnx
